BIHR_USERNAME=
BIHR_PASSWORD=
BIHR_BASE_URL=
DATABASE_URL=
TEST_DATABASE_URL=

# Read-only connection string for Reference Inteligencia's database, used
# only by `match-brands`. Provisioning the role (bihr_connector_ro) on the
# shared totimport-postgres instance and setting the real value here is a
# deployment-time action coordinated with Loic -- never put the real
# connection string in this file, only the variable name.
RI_DATABASE_URL=

# How often (hours) an active brand's incremental refresh may re-run.
# Default 2h -- deliberately stricter than the bulk catalog cadences
# (Stocks, the tightest, is 6h) but not unbounded. Optional; only set this
# to override the default.
INCREMENTAL_REFRESH_HOURS=2
