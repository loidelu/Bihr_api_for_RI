BIHR_USERNAME=
BIHR_PASSWORD=
BIHR_BASE_URL=
DATABASE_URL=
TEST_DATABASE_URL=

# Read-only connection string for Reference Inteligencia's database, used
# only by `match-brands`. Provisioning the role (bihr_connector_ro) on the
# shared totimport-postgres instance and setting the real value here is a
# deployment-time action coordinated with Loic -- never put the real
# connection string in this file, only the variable name.
RI_DATABASE_URL=

# Schema RI's tables (core_manufacturers, source_brand_labels,
# master_products) live in on RI_DATABASE_URL's database. Defaults to "ri"
# (the real production value, per RI's own ADR 0005) when unset -- only
# override this for tests or alternate deployments where RI's tables sit
# in a different schema.
RI_SCHEMA=ri

# How often (hours) an active brand's incremental refresh may re-run.
# Default 2h -- deliberately stricter than the bulk catalog cadences
# (Stocks, the tightest, is 6h) but not unbounded. Optional; only set this
# to override the default.
INCREMENTAL_REFRESH_HOURS=2

# Shared secret the internal HTTP API (bihr_connector/api.py) requires on
# the X-Hub-Token header for every protected endpoint (connectors-hub is
# the intended caller). Empty/unset means every protected endpoint stays
# locked (the API never authorizes against an empty token) -- generate a
# real random value at deployment time, never put it in this file.
HUB_API_TOKEN=
